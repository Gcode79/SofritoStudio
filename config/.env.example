# ============================================================
# Sofrito Studio — Consolidated Environment Template
# Copy to config/.env and fill in real values. NEVER commit .env.
# ============================================================

# --- Email (Buttondown) ---
BUTTONDOWN_API_KEY=
BUTTONDOWN_USERNAME=joshortiz56

# --- Payments (Gumroad) ---
# Gumroad Settings > Advanced > API
GUMROAD_ACCESS_TOKEN=
# Webhook signature secret (optional — enable in Gumroad webhook settings)
GUMROAD_WEBHOOK_SECRET=

# --- Cloudflare ---
# For wrangler deploy (or use `npx wrangler login` instead)
CF_API_TOKEN=

# --- Social posting ---
# Pinterest API v5
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=
# Public image URL used as pin media (required to publish Pinterest pins)
PIN_MEDIA_URL=
# Meta (Facebook/Instagram)
META_ACCESS_TOKEN=
META_PAGE_ID=
META_INSTAGRAM_ACCOUNT_ID=
# TikTok
TIKTOK_ACCESS_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- SMS (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Analytics ---
GA4_MEASUREMENT_ID=

# --- Image generation (optional) ---
OPENAI_API_KEY=
