{
  "description": "Hybrid monetization content model for sofritostudio.com. Three content types share one multilingual core; every user-facing string is an {en, es} pair.",
  "contentTypes": {
    "recipe": {
      "purpose": "Free gateway content for organic SEO and funnel entry.",
      "access": "free",
      "fields": {
        "slug": "string",
        "name": "i18n string",
        "description": "i18n string",
        "image": "string[]",
        "category": "string",
        "keywords": "string",
        "datePublished": "ISO date",
        "prepTime": "ISO 8601 duration",
        "cookTime": "ISO 8601 duration",
        "totalTime": "ISO 8601 duration",
        "servings": { "base": "number" },
        "yield": "i18n string",
        "ingredients": [{ "gid": "string", "name": "i18n string", "items": [{ "qty": "number", "unit": "string", "metric": { "qty": "number", "unit": "string" }, "name": "i18n string" }] }],
        "steps": "i18n string[]",
        "cart": { "type": "gumroad|affiliate|stripe", "url": "string", "productKey": "string" },
        "relatedProducts": "string[] (product skus)"
      },
      "seo": "Schema.org Recipe + HowTo, dual-language JSON-LD"
    },
    "productDigital": {
      "purpose": "Premium downloadable PDFs / e-books with instant post-purchase fulfillment.",
      "access": "paid",
      "fields": {
        "sku": "string",
        "name": "i18n string",
        "description": "i18n string",
        "image": "string[]",
        "price": "number (USD)",
        "compareAtPrice": "number?",
        "gumroadProductId": "string",
        "files": ["string (package/ file paths)"],
        "version": "string",
        "license": "string",
        "isbn": "string?"
      },
      "fulfillment": "Instant download hook fires on paid status; file set from /packages/<sku>/; re-download via lifetime access link.",
      "seo": "Schema.org Product, category = DigitalDownload"
    },
    "productPhysical": {
      "purpose": "Custom spice blends, cookery tools, pantry items.",
      "access": "paid",
      "fields": {
        "sku": "string",
        "name": "i18n string",
        "description": "i18n string",
        "image": "string[]",
        "price": "number (USD)",
        "compareAtPrice": "number?",
        "stock": "number",
        "lowStockThreshold": "number",
        "weightGrams": "number",
        "dimensions": { "length": "cm", "width": "cm", "height": "cm" },
        "shippingProfile": "string",
        "hazmat": "boolean",
        "active": "boolean"
      },
      "fulfillment": "Inventory decremented on order; Stripe + express shipping carriers.",
      "seo": "Schema.org Product, category = PhysicalGood"
    }
  },
  "shared": {
    "i18n": {
      "engine": "js/i18n.js",
      "locales": ["en-US", "es-PR"],
      "storage": "localStorage key sofrito.lang; <html lang> synced"
    },
    "checkout": {
      "digital": "Gumroad (existing SITE_CONFIG.gumroad)",
      "physical": "Stripe Payment Elements with Apple Pay / Google Pay via Payment Request",
      "cart": "localStorage key sofrito.cart, driven by js/checkout.js"
    },
    "performance": {
      "noAdNetworks": true,
      "cssDelivery": "critical inline + lazy non-critical (existing pattern)",
      "fonts": "Fraunces + Inter (preconnected)",
      "images": "avif/webp + width/height attrs + loading=lazy"
    }
  }
}
